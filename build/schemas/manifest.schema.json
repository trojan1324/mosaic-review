{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/schemas/manifest.schema.json",
  "title": "Article package manifest, the root object of packages/<work_id>/<package_version>/ (FINAL v2 §4.2, C17)",
  "x-mosaic-type": "manifest",
  "type": "object",
  "required": ["type", "schema_version", "package_id", "work_id", "package_version", "recipe", "inputs", "objects",
               "extraction_scope", "coverage", "stage_totals", "status", "evidence_classes"],
  "properties": {
    "type": {"const": "manifest"},
    "schema_version": {"const": "mosaic.manifest/1"},
    "package_id": {"$ref": "common.schema.json#/$defs/package_id"},
    "work_id": {"type": "string", "minLength": 1},
    "package_version": {"type": "string", "pattern": "^v[0-9]{4}$"},
    "supersedes": {"type": ["string", "null"], "pattern": "^v[0-9]{4}$"},
    "recipe": {"type": "object", "required": ["recipe_id", "recipe_sha256"],
               "properties": {"recipe_id": {"type": "string", "pattern": "^recipe-[0-9a-f]{64}$"},
                              "recipe_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
                              "name": {"type": "string"},
                              "code_sha256": {"$ref": "common.schema.json#/$defs/sha256"}},
               "additionalProperties": false},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "sha256", "path"],
               "properties": {"role": {"type": "string"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
                              "path": {"type": "string"}, "bytes": {"type": "integer"}},
               "additionalProperties": false}},
    "objects": {
      "description": "Every object id in objects/, grouped by type; each file name is <id>.json and its content hashes to the id",
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/$defs/object_type"},
      "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/object_ref"}}
    },
    "extraction_scope": {"type": "object", "required": ["profile", "tables", "notes"],
                         "properties": {"profile": {"type": "string"}, "tables": {"enum": ["excluded", "graceful_degradation_only", "reactivated_with_contract"]},
                                        "notes": {"type": "string"},
                                        "model_source_policy": {"$ref": "model-source-policy.schema.json"}},
                         "additionalProperties": false},
    "coverage": {"type": "object", "required": ["pages_total", "dispositions"],
                 "properties": {"pages_total": {"type": "integer", "minimum": 0},
                                "dispositions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
                                "docx_paragraphs_total": {"type": "integer", "minimum": 0},
                                "denominator_note": {"type": "string"}},
                 "additionalProperties": false},
    "stage_totals": {"type": "object", "additionalProperties": {"type": "string"}},
    "evidence_classes": {
      "description": "How much of the package is deterministic, replayed historical model output, or Jev advisory signal (HANDOFF §6.8)",
      "type": "object", "required": ["deterministic", "replayed_historical_output", "jev_advisory"],
      "properties": {"deterministic": {"type": "integer", "minimum": 0}, "replayed_historical_output": {"type": "integer", "minimum": 0},
                     "jev_advisory": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "permissions": {"type": "object"},
    "created_utc": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "status": {"enum": ["materialized", "incomplete", "failed"]}
  },
  "additionalProperties": false
}
