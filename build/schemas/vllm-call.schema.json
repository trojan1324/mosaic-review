{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/schemas/vllm-call.schema.json",
  "title": "One row of ledgers/vllm_calls/<candidate>.jsonl (MODEL_SELECTION_PLAN.md S0; VS1-VS8)",
  "x-mosaic-type": null,
  "type": "object",
  "required": ["row_kind", "idempotency_key", "route", "request_sha256", "packet_sha256", "target_work_id", "timestamp_utc"],
  "properties": {
    "row_kind": {"enum": ["intent", "result"]},
    "idempotency_key": {"type": "string", "pattern": "^idem-[0-9a-f]{64}$"},
    "route": {"enum": ["chat_completions", "tokenize", "health", "repair"]},
    "method": {"enum": ["GET", "POST"]},
    "request_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "request_body_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "response_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "response_bytes": {"type": "integer", "minimum": 0},
    "packet_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "target_work_id": {"type": "string"},
    "batch_id": {"type": ["string", "null"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "outcome": {"enum": ["pending", "success", "http_error", "transport_error", "unknown_outcome",
                         "refused_by_hard_stop", "schema_invalid", "truncated", "looping_detected",
                         "repaired", "repair_failed"]},
    "http_status": {"type": ["integer", "null"]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "is_repair": {"type": "boolean"},
    "repair_of": {"type": ["string", "null"]},
    "candidate_ids_offered": {"type": "array", "items": {"type": "string"}},
    "candidate_ids_used": {"type": "array", "items": {"type": "string"}},
    "text_provenance": {"enum": ["native_article_text", "fixture_replay", "none"]},
    "source_sha256s": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sha256"}},
    "model": {"type": ["string", "null"]},
    "revision": {"type": ["string", "null"]},
    "timestamp_utc": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "detail": {"type": "string"}
  },
  "additionalProperties": false
}
