{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/schemas/table.schema.json",
  "title": "Table with cells, header paths, notes, significance markers and continuation links (FINAL v2 §4.1-4.2; audit C-05, M-20, N-55)",
  "x-mosaic-type": "table",
  "allOf": [{"$ref": "common.schema.json#/$defs/envelope"},
            {"if": {"properties": {"structure_status": {"const": "single_page_resolved"}}, "required": ["structure_status"]},
             "then": {"properties": {"page_ids": {"minItems": 1}}}}],
  "type": "object",
  "required": ["source_id", "page_ids", "caption", "structure_status", "columns", "cells", "continuation"],
  "properties": {
    "type": {"const": "table"},
    "schema_version": {"const": "mosaic.table/1"},
    "source_package_id": true, "created_by": true, "recipe_id": true, "provenance_ids": true,
    "status": {"enum": ["captured", "unsupported", "quarantined"]},
    "source_id": {"$ref": "common.schema.json#/$defs/object_ref"},
    "page_ids": {"type": "array", "minItems": 0, "items": {"$ref": "common.schema.json#/$defs/object_ref"}},
    "label": {"type": ["string", "null"]},
    "caption": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}, "witness_id": {"$ref": "common.schema.json#/$defs/object_ref"}}, "additionalProperties": false},
    "owner_study_local_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/local_id"}, {"type": "null"}]},
    "ownership_basis": {"type": "string"},
    "structure_status": {"enum": ["single_page_resolved", "unsupported_multi_page", "unsupported_merged_headers", "unsupported_multi_table_page", "unsupported_rotated", "unresolved"]},
    "unsupported_reason": {"type": "string"},
    "columns": {"type": "array", "items": {"type": "object", "required": ["column_id", "header_path"],
                "properties": {"column_id": {"type": "string"}, "header_path": {"type": "array", "items": {"type": "string"}},
                               "count_role": {"enum": ["count", "not_count", "unknown"]}},
                "additionalProperties": false}},
    "cells": {"type": "array", "items": {"type": "object", "required": ["position", "text"],
              "$comment": "position omits table_id: an object cannot contain its own content-derived id; witnesses carry the full {table_id, row_index_or_path, column_id, header_path} locator",
              "properties": {"position": {"type": "object", "required": ["row_index_or_path", "column_id", "header_path"],
                                          "properties": {"row_index_or_path": {"$ref": "common.schema.json#/$defs/table_cell_locator/properties/row_index_or_path"},
                                                         "column_id": {"type": "string", "minLength": 1},
                                                         "header_path": {"type": "array", "items": {"type": "string"}}},
                                          "additionalProperties": false},
                             "text": {"type": "string"}, "bbox": {"$ref": "common.schema.json#/$defs/bbox"},
                             "row_span": {"type": "integer", "minimum": 1}, "col_span": {"type": "integer", "minimum": 1},
                             "significance_markers": {"type": "array", "items": {"type": "string"}}},
              "additionalProperties": false}},
    "notes": {"type": "array", "items": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string"}, "witness_id": {"$ref": "common.schema.json#/$defs/object_ref"}}, "additionalProperties": false}},
    "panels": {"type": "array", "items": {"type": "object", "required": ["panel_id", "title", "owner_study_local_id", "ownership_basis"],
               "properties": {"panel_id": {"type": "string", "minLength": 1}, "title": {"type": "string"},
                              "owner_study_local_id": {"$ref": "common.schema.json#/$defs/local_id"},
                              "ownership_basis": {"type": "string"}},
               "additionalProperties": false}},
    "units": {"type": ["string", "null"]},
    "continuation": {
      "type": "object", "required": ["status"],
      "properties": {"status": {"enum": ["none", "continues_table", "unresolved_continuation"]},
                     "parent_table_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/object_ref"}, {"type": "null"}]},
                     "column_mapping": {"type": "object", "additionalProperties": {"type": "string"}}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
