{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/schemas/assertion.schema.json",
  "title": "Assertion envelope (FINAL v2 §4.3-4.4; audit M-13, M-15, M-18, M-19, M-28, M-29)",
  "x-mosaic-type": "assertion",
  "$comment": "Every if/then, uniqueItems, patternProperties, format and numeric bound here is also enforced by mosaic.validation.objects.check_assertion, because the pinned decoder ignores them (M-32).",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {"if": {"properties": {"state": {"const": "present"}}, "required": ["state"]},
     "then": {"required": ["value", "witness_ids"], "properties": {"value": {"type": "object"}, "witness_ids": {"minItems": 1}}}},
    {"if": {"properties": {"state": {"const": "explicitly_absent"}}, "required": ["state"]},
     "then": {"required": ["witness_ids"], "properties": {"witness_ids": {"minItems": 1}}}},
    {"if": {"properties": {"state": {"const": "not_found_in_reviewed_scope"}}, "required": ["state"]},
     "then": {"required": ["reviewed_scope"], "properties": {"value": {"type": "null"}}}},
    {"if": {"properties": {"state": {"const": "ambiguous_or_conflicting"}}, "required": ["state"]},
     "then": {"required": ["alternatives"], "properties": {"alternatives": {"minItems": 2}}}},
    {"if": {"properties": {"state": {"enum": ["unavailable_or_illegible", "not_applicable", "not_processed"]}}, "required": ["state"]},
     "then": {"required": ["reason"]}},
    {"if": {"properties": {"family": {"const": "psychometric"}}, "required": ["family"]},
     "then": {"properties": {"scope": {"required": ["instrument_version_id", "sample_id", "administration_id", "analysis_id"]}}}},
    {"if": {"properties": {"family": {"const": "result"}}, "required": ["family"]},
     "then": {"properties": {"scope": {"required": ["study_id", "sample_id", "analysis_id"]}}}},
    {"if": {"properties": {"family": {"enum": ["result", "psychometric", "interpretation"]}}, "required": ["family"]},
     "then": {"required": ["result_attribution"]}},
    {"if": {"properties": {"interpretation_kind": {"const": "derived"}}, "required": ["interpretation_kind"]},
     "then": {"required": ["derivation"]}},
    {"if": {"properties": {"acceptance_tier": {"enum": ["accepted", "citable"]}}, "required": ["acceptance_tier"]},
     "then": {"required": ["acceptance_basis"]}},
    {"if": {"properties": {"acceptance_basis": {"const": "human_adjudication"}}, "required": ["acceptance_basis"]},
     "then": {"required": ["adjudication"]}}
  ],
  "type": "object",
  "required": ["family", "subject_id", "predicate", "scope", "state", "witness_ids", "interpretation_kind",
               "validation_status", "acceptance_tier", "candidate_origin"],
  "properties": {
    "type": {"const": "assertion"},
    "schema_version": {"const": "mosaic.assertion/1"},
    "source_package_id": true, "created_by": true, "recipe_id": true, "provenance_ids": true,
    "status": {"enum": ["materialized", "stale", "superseded"]},
    "family": {"enum": ["entity", "work", "theory", "study_design", "sample", "variable", "intervention", "measure",
                        "psychometric", "result", "procedure", "qualitative", "review", "interpretation"]},
    "subject_id": {"$ref": "common.schema.json#/$defs/local_id"},
    "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "scope": {
      "description": "Members enumerated per family (FINAL v2 §4.3 table); every member is a *_id naming a package-local entity",
      "type": "object",
      "patternProperties": {"^[a-z_]+_id$": {"oneOf": [{"$ref": "common.schema.json#/$defs/local_id"}, {"type": "null"}]}},
      "additionalProperties": false
    },
    "state": {"enum": ["present", "explicitly_absent", "not_found_in_reviewed_scope", "ambiguous_or_conflicting",
                       "unavailable_or_illegible", "not_applicable", "not_processed"]},
    "value": {"oneOf": [{"$ref": "common.schema.json#/$defs/value"}, {"type": "null"}]},
    "alternatives": {
      "type": "array",
      "items": {"type": "object", "required": ["value", "witness_ids"],
                "properties": {"value": {"$ref": "common.schema.json#/$defs/value"},
                               "witness_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/witness_ref"}}},
                "additionalProperties": false}
    },
    "witness_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/witness_ref"}},
    "reviewed_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 1},
    "interpretation_kind": {"enum": ["reported", "author_interpretation", "extractor_inference", "derived"]},
    "result_attribution": {"enum": ["author_result", "author_interpretation", "secondary_report", "landscape_association",
                                    "deterministic_derivation", "system_hypothesis"]},
    "cited_work": {"type": "object", "properties": {"text": {"type": "string"}, "resolved_id": {"type": ["string", "null"]}},
                   "additionalProperties": false},
    "derivation": {
      "type": "object", "required": ["formula", "input_witness_ids", "assumptions"],
      "properties": {"formula": {"type": "string", "minLength": 1},
                     "input_witness_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/witness_ref"}},
                     "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
      "additionalProperties": false
    },
    "validation_status": {"enum": ["candidate", "mechanically_valid", "needs_review", "accepted", "rejected"]},
    "acceptance_tier": {"enum": ["candidate", "inspectable", "accepted", "citable", "synthesis"]},
    "acceptance_basis": {"enum": ["qualified_recipe", "human_adjudication"]},
    "adjudication": {
      "type": "object", "required": ["reviewer", "consulted_witness_ids", "gate_confirmations", "recorded_utc"],
      "properties": {"reviewer": {"type": "string", "minLength": 1},
                     "consulted_witness_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/witness_ref"}},
                     "gate_confirmations": {"type": "object",
                                            "required": ["G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8"],
                                            "patternProperties": {"^G[1-8]$": {"type": "boolean"}},
                                            "additionalProperties": false},
                     "recorded_utc": {"$ref": "common.schema.json#/$defs/utc_timestamp"}},
      "additionalProperties": false
    },
    "candidate_origin": {
      "type": "object", "required": ["backend", "evidence_label"],
      "properties": {"backend": {"enum": ["fixture", "gateway_jev", "real_provider", "vllm", "deterministic", "human"]},
                     "evidence_label": {"enum": ["replayed historical output", "deterministic extraction", "jev advisory signal", "human review", "live vllm candidate output"]},
                     "source_file": {"type": "string"},
                     "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
                     "source_pointer": {"type": "string"},
                     "claim_text": {"type": "string"}},
      "additionalProperties": false
    },
    "flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
