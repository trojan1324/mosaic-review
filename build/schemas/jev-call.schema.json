{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/schemas/jev-call.schema.json",
  "title": "One row of ledgers/jev_calls.jsonl (HANDOFF §6.6; FINAL v2 §12.5)",
  "x-mosaic-type": null,
  "type": "object",
  "required": ["row_kind", "idempotency_key", "route", "request_sha256", "prompt_state_sha256", "target_work_id", "timestamp_utc"],
  "properties": {
    "row_kind": {"enum": ["intent", "result"]},
    "idempotency_key": {"type": "string", "pattern": "^idem-[0-9a-f]{64}$"},
    "route": {"enum": ["typesafe_compatible_systemone", "typesafe_models_probe"]},
    "method": {"enum": ["GET", "POST"]},
    "request_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "prompt_state_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "target_work_id": {"type": "string"},
    "fixture_replay": {"type": "boolean"},
    "zero_data_retention": {"const": true},
    "outcome": {"enum": ["pending", "success", "http_error", "transport_error", "unknown_outcome", "refused_by_hard_stop"]},
    "http_status": {"type": ["integer", "null"]},
    "generation_id": {"type": ["string", "null"]},
    "canonical_slug": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "gateway_cost_usd": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "timestamp_utc": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
    "detail": {"type": "string"},
    "purpose": {"enum": ["advisory", "probe"]},
    "pattern": {"type": "string", "description": "Question family, e.g. J1 or J9 (FINAL v2 §7.2)"},
    "question_ids": {"type": "array", "items": {"type": "string"}},
    "text_provenance": {"enum": ["native_article_text", "fixture_replay", "none"]},
    "source_sha256s": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sha256"}},
    "estimated_cost_usd": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "market_cost_usd": {"type": ["string", "null"]},
    "answers": {"type": "object", "description": "Typed answers with their distributions, as returned; never the state text"},
    "zdr_evidence": {"type": ["string", "null"], "description": "routing.planningReasoning when the gateway reports it"},
    "rate_limit_headers": {"type": "object", "additionalProperties": {"type": "string"}},
    "response": {"type": "object", "description": "Full response body of the models probe"}
  },
  "additionalProperties": false
}
