{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/schemas/recipe.schema.json",
  "title": "Recipe digest (FINAL v2 §10.1 full recipe digest; audit N-60 OCR availability)",
  "x-mosaic-type": null,
  "type": "object",
  "required": ["recipe_version", "name", "pipeline_version", "parsers", "ocr", "candidate_backend", "validators", "jev", "schemas_sha256"],
  "properties": {
    "recipe_version": {"const": "mosaic.recipe/1"},
    "name": {"type": "string", "pattern": "^[a-z0-9_.\\-]+$"},
    "pipeline_version": {"type": "string"},
    "parsers": {"type": "object", "required": ["pymupdf"], "additionalProperties": {"type": "string"}},
    "ocr": {"type": "object", "required": ["tesseract", "rapidocr"],
            "properties": {"tesseract": {"type": "object", "required": ["available"], "properties": {"available": {"type": "boolean"}, "path": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]}}, "additionalProperties": false},
                           "rapidocr": {"type": "object", "required": ["available"], "properties": {"available": {"type": "boolean"}, "version": {"type": ["string", "null"]}}, "additionalProperties": false}},
            "additionalProperties": false},
    "candidate_backend": {"enum": ["fixture", "gateway_jev", "real_provider", "vllm", "none"]},
    "fixture_sources": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "work_id": {"type": "string"}, "role": {"enum": ["focus", "structure"]}}, "additionalProperties": false}},
    "vllm": {"type": "object",
             "required": ["base_url_env", "model", "revision", "served_model_name", "max_output_tokens", "temperature",
                         "seed", "reasoning", "structured_outputs_backend", "remote"],
             "properties": {"base_url_env": {"type": "string"}, "model": {"type": "string"}, "revision": {"type": "string"},
                            "served_model_name": {"type": "string"}, "max_output_tokens": {"type": "integer"},
                            "temperature": {"type": "number"}, "seed": {"type": "integer"},
                            "reasoning": {"type": ["object", "null"]}, "enable_thinking": {"type": "boolean"}, "fine_span_options": {"type": "boolean"}, "saturation_strategy": {"enum": ["split_core_v1", "split_core_v2"]}, "local_tokenizer": {"type": "object", "required": ["model", "revision", "path", "sha256", "runtime_version", "add_special_tokens"], "properties": {"model": {"type": "string"}, "revision": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "runtime_version": {"type": "string"}, "add_special_tokens": {"type": "boolean"}}, "additionalProperties": false}, "structured_outputs_backend": {"type": "string"},
                            "remote": {"type": "boolean"},
                            "response_contract": {"enum": ["core_v2"]},
                            "prompt_sha256": {"$ref": "common.schema.json#/$defs/sha256"}},
             "additionalProperties": false},
    "validators": {"type": "object", "additionalProperties": {"type": "string"}},
    "jev": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}, "route": {"type": ["string", "null"]}, "questions_sha256": {"type": ["string", "null"]}}, "additionalProperties": false},
    "schemas_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "renders_dpi": {"type": "array", "items": {"enum": [150, 300]}},
    "scope_profile": {"type": "string"}
  },
  "additionalProperties": false
}
